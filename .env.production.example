# ===========================================
# Laundry AI Inspection System — Production
# Single domain: dryclean.synmodel.com
#   /          → staff-app (includes /admin route, role-gated)
#   /sign/     → customer-sign (QR code confirmations)
#   /api/      → backend API
#   /storage/  → photo files
# ===========================================

# ----- Database -----
POSTGRES_USER=laundry
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=laundry_db

# ----- Backend API -----
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
OPENAI_API_KEY=sk-proj-XXXXXXXXX
# The public-facing URL of your server / load balancer
API_BASE_URL=https://dryclean.synmodel.com
# CORS: allow your domain + Capacitor native origins (iOS/Android app)
CORS_ORIGINS=https://dryclean.synmodel.com,capacitor://localhost,ionic://localhost
MAX_UPLOAD_SIZE=20971520

# ----- Frontend build-time URLs -----
# Passed as VITE_API_BASE_URL to staff-app and customer-sign
# For Capacitor native app builds, set this to the full API URL
CUSTOMER_SIGN_BASE_URL=https://dryclean.synmodel.com/sign

# ----- AI model config (optional overrides) -----
# Primary model for full-image detection passes (gpt-4.1 recommended)
# OPENAI_DETECT_PRIMARY_MODEL=gpt-4.1
# Cheaper model for secondary passes (verify/hotspot/crops/rescue)
# OPENAI_DETECT_SECONDARY_MODEL=gpt-4.1-mini
# Number of parallel focus-crop workers per photo
# OPENAI_DETECT_CROP_WORKERS=5
# Max focus crops per photo (set lower to speed up, higher for more recall)
# OPENAI_DETECT_MAX_FOCUS_CROPS=9

# ----- AWS (for ECS/S3 deployment) -----
# AWS_S3_BUCKET=dryclean-photos-ACCOUNT_ID
# AWS_REGION=us-east-1
# AWS_CLOUDFRONT_URL=https://d1234.cloudfront.net
